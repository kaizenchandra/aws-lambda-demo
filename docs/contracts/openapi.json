  "components": {
    "securitySchemes": {
      "awsSigV4": {
        "type": "apiKey",
        "name": "Authorization",
        "in": "header",
        "x-amazon-apigateway-authtype": "awsSigv4",
        "description": "Sign with temporary AWS credentials for execute-api; local mode is unsigned."
      }
    }
  }
